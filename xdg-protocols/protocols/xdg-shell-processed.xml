<?xml version="1.0" encoding="utf-8"?>
<protocol name="xdg-shell">
 <copyright>
  Copyright 2015-2017 The Wayland Project
 </copyright>
 <interface name="xdg_wm_base">
  <request name="create_positioner" type="new_id" interface="xdg_positioner"/>
  <request name="get_xdg_surface" type="new_id" interface="xdg_surface"/>
  <request name="pong" />
  <event name="ping">
   <arg name="serial" type="uint"/>
  </event>
 </interface>

 <interface name="xdg_surface">
  <request name="get_toplevel" type="new_id" interface="xdg_toplevel"/>
  <request name="ack_configure" >
   <arg name="serial" type="uint"/>
  </request>
  <event name="configure">
   <arg name="width" type="uint"/>
   <arg name="height" type="uint"/>
   <arg name="serial" type="uint"/>
  </event>
 </interface>

 <interface name="xdg_toplevel">
  <request name="set_title">
   <arg name="title" type="string"/>
  </request>
  <request name="set_app_id">
   <arg name="app_id" type="string"/>
  </request>
  <request name="show_window_menu">
   <arg name="seat" type="object"/>
   <arg name="serial" type="uint"/>
   <arg name="x" type="int"/>
   <arg name="y" type="int"/>
  </request>
  <request name="move">
   <arg name="seat" type="object"/>
   <arg name="serial" type="uint"/>
  </request>
  <request name="resize">
   <arg name="seat" type="object"/>
   <arg name="serial" type="uint"/>
   <arg name="edges" type="uint"/>
  </request>
  <request name="set_maximized"/>
  <request name="unset_maximized"/>
  <request name="set_minimized"/>
  <request name="set_fullscreen">
   <arg name="output" type="object"/>
  </request>
  <request name="request_close"/>
  <event name="configure">
   <arg name="width" type="uint"/>
   <arg name="height" type="uint"/>
  </event>
 </interface>
</protocol>
