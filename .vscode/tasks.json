{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Local",
			"type": "shell",
			"command": "cargo build --target aarch64-unknown-linux-gnu",
			"group": "build"
		},
		{
			"label": "Test Local",
			"type": "shell",
			"command": "cargo test --target aarch64-unknown-linux-gnu"
		},
		{
			"label": "Build macOS",
			"type": "shell",
			"command": "ssh",
			"args": ["macbuilder", "cd ~/projects/mylib && cargo build --target aarch64-apple-darwin"],
			"group": "build"
		},
		{
			"label": "Test macOS",
			"type": "shell",
			"command": "ssh",
			"args": ["macbuilder", "cd ~/projects/mylib && cargo test --target aarch64-apple-darwin"]
		},
		{
			"label": "Build Android x86_64",
			"type": "shell",
			"command": "ssh",
			"args": ["androidbuilder", "cd ~/projects/mylib && ./gradlew build"],
			"group": "build"
		}
	]
}
